{
  "version": 1,
  "execute": false,
  "control": "/var/lib/aark/case-001",
  "pollMs": 30000,
  "probeTimeoutMs": 10000,
  "maxConcurrent": 1,
  "jobs": [
    {
      "id": "job-000001",
      "dependsOn": [],
      "attempts": [
        "/etc/aark/carved-workflow.json",
        "/etc/aark/carved-workflow-followup.json"
      ],
      "resumeAfterQuota": false
    },
    {
      "id": "job-000002",
      "dependsOn": [],
      "attempts": ["/etc/aark/raw-stream-workflow.json"],
      "resumeAfterQuota": false
    }
  ],
  "agent": {
    "ownership": "dedicated-thread",
    "executable": "/usr/bin/codex",
    "socketPath": "/run/aark/codex.sock",
    "threadId": "11111111-1111-4111-8111-111111111111",
    "user": "aark-agent",
    "readableRoots": ["/opt/aark"],
    "timeoutMs": 300000,
    "maxRequests": 20
  }
}
